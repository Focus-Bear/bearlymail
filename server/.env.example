# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=adhd_email_client

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Google Calendar API
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Calendar Booking URL
CALENDAR_BOOKING_URL=https://calendly.com/your-link

# Frontend URL
FRONTEND_URL=http://localhost:3000

# LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low

# LLM Job Processing Configuration
# LLM_PRIORITY_CONCURRENCY=8       # Number of parallel priority calculation workers
# LLM_SUMMARY_PARALLEL_CALLS=5     # Number of parallel LLM calls per batch (fires concurrently, not blocking)
