{
  "name": "adhd-email-client-server",
  "version": "1.1.0",
  "description": "Backend server for ADHD-Friendly Email Client",
  "author": "",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "worker": "ts-node -r tsconfig-paths/register src/worker.ts",
    "worker:dev": "nodemon --watch src --ext ts --exec \"ts-node -r tsconfig-paths/register src/worker.ts\"",
    "worker:prod": "node dist/worker",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns='.integration.spec.ts$'",
    "test:integration": "jest --testRegex='.*\\.integration\\.spec\\.ts$' --runInBand",
    "test:watch": "jest --watch --maxWorkers=50%",
    "test:cov": "jest --coverage --testPathIgnorePatterns='.integration.spec.ts$'",
    "test:integration:cov": "jest --coverage --testRegex='.*\\.integration\\.spec\\.ts$' --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:timing": "JEST_TIMING=true jest",
    "test:detect-network": "DETECT_NETWORK_CALLS=true jest",
    "test:slow": "jest --verbose",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/data-source.js",
    "migration:revert:prod": "typeorm migration:revert -d dist/data-source.js",
    "migration:show:prod": "typeorm migration:show -d dist/data-source.js",
    "migration:fix": "ts-node -r tsconfig-paths/register src/scripts/fix-migration-state.ts",
    "check-indexes": "ts-node -r tsconfig-paths/register scripts/check-and-add-indexes.ts",
    "check-schema-drift": "scripts/check-schema-drift.sh",
    "analyze-queries": "ts-node -r tsconfig-paths/register scripts/analyze-slow-queries.ts",
    "jobs:reset": "ts-node -r tsconfig-paths/register src/scripts/reset-stuck-jobs.ts",
    "fix:stuck-calculating": "ts-node -r tsconfig-paths/register src/scripts/fix-stuck-calculating.ts",
    "seed:test-user": "ts-node -r tsconfig-paths/register scripts/seed-test-user.ts",
    "promptfoo:test": "node scripts/run-promptfoo-tests.js",
    "promptfoo:view": "promptfoo view promptfoo",
    "security:audit": "ts-node -r tsconfig-paths/register scripts/security-audit.ts",
    "security:audit:diff": "ts-node -r tsconfig-paths/register scripts/security-audit.ts --diff",
    "security:audit:llm": "ts-node -r tsconfig-paths/register scripts/security-audit.ts --llm",
    "security:audit:diff:llm": "ts-node -r tsconfig-paths/register scripts/security-audit.ts --diff --llm"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.947.0",
    "@aws-sdk/client-ecs": "^3.947.0",
    "@aws-sdk/client-ses": "^3.947.0",
    "@google/generative-ai": "^0.2.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/typeorm": "^10.0.1",
    "@octokit/rest": "^22.0.1",
    "@types/mjml": "^4.7.4",
    "axios": "^1.13.2",
    "bcrypt": "^5.1.1",
    "chrono-node": "^2.7.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "crypto-js": "^4.2.0",
    "form-data": "^4.0.5",
    "googleapis": "^128.0.0",
    "i18next": "^25.7.2",
    "luxon": "^3.7.2",
    "mjml": "^4.18.0",
    "natural": "^6.10.3",
    "openai": "^6.21.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "pg-boss": "^9.0.3",
    "posthog-node": "^5.21.2",
    "pusher": "^5.3.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/jscodeshift": "^17.3.0",
    "@types/luxon": "^3.7.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.33",
    "@types/passport-google-oauth20": "^2.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.1",
    "jscodeshift": "^17.3.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "promptfoo": "^0.120.4",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "isolatedModules": true,
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true,
            "allowSyntheticDefaultImports": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coverageThreshold": {
      "global": {
        "branches": 15,
        "functions": 21,
        "lines": 26,
        "statements": 27
      }
    },
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(@octokit|universal-user-agent|before-after-hook)/)"
    ],
    "moduleNameMapper": {
      "^app-root-path$": "<rootDir>/__mocks__/app-root-path.ts"
    },
    "setupFilesAfterEnv": [
      "../jest.setup.ts"
    ],
    "maxWorkers": "100%",
    "workerIdleMemoryLimit": "512MB",
    "cache": true,
    "cacheDirectory": "../.jest-cache",
    "verbose": false,
    "detectOpenHandles": false,
    "forceExit": true,
    "testTimeout": 10000,
    "slowTestThreshold": 1,
    "bail": false,
    "errorOnDeprecated": false
  }
}
