# PostHog Error Scanner — Environment Variables
# Copy to ~/.openclaw/posthog-scanner.env and fill in your values.
# NEVER commit this file to the repo.

# PostHog personal API key (query:read scope)
# Get from: https://us.posthog.com/settings/user-api-keys#personal-api-keys
POSTHOG_PERSONAL_API_KEY=phx_your_personal_api_key_here

# Numeric PostHog project ID
# Visible in the URL: https://us.posthog.com/project/{ID}/settings
# ⚠️ Jeremy must provide this value
POSTHOG_PROJECT_ID=12345

# Optional overrides (uncomment to customize):
# POSTHOG_HOST=us.posthog.com
# POSTHOG_LOOKBACK_HOURS=24
# POSTHOG_RESULT_LIMIT=50
# POSTHOG_URGENT_THRESHOLD=10
# DEFAULT_GITHUB_REPO=Focus-Bear/BearlyMail
# STATE_FILE=~/.openclaw/posthog-scanner-state.json
